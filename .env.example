# Required: where the actual sync worker lives (separate from Vercel because syncs take >5min)
WORKER_URL=https://your-worker.onrender.com
WORKER_API_KEY=long-random-secret-shared-with-worker

# Required: Glean for read-only monitoring (no long-running ops)
GLEAN_API_URL=https://usdm-be.glean.com
GLEAN_INDEXING_API_TOKEN=your-glean-token

# Required: Vault for read-only audit endpoints
VAULT_DNS=partnersi-usdm-quality.veevavault.com
VAULT_USERNAME=jbotero@partnersi-usdm.com
VAULT_PASSWORD=your-vault-password

# Required: admin auth (one of)
ADMIN_PASSWORD=set-a-strong-password
# OR for SSO, use Vercel's built-in Password Protection (Project Settings → Deployment Protection)

# Required: Cron secret (Vercel injects this automatically on cron paths)
CRON_SECRET=auto-generated-by-vercel

# Optional: Slack webhook for notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
